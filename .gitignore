# macOS
.DS_Store

# Xcode: per-user state, never shared
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Build output
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.swiftpm/
.build/

# Local-only runtime files: pairing records, sealed vaults, keys
*.mobiledevicepairing
*.vault
.env
*.p12
*.mobileprovision

# The product's source is deliberately not tracked: Focus Plus is closed source
# and the repository keeps only the README, the licence notices and the
# workflow. Those files are left untracked rather than ignored, because the
# build tooling syncs the working tree and needs to see them — never add them
# to a commit.
