# macOS
.DS_Store

# Xcode: per-user state, never shared
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint

# Build output
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip

# Swift Package Manager
.swiftpm/
.build/

# Local-only runtime files: pairing records, sealed vaults, keys
*.mobiledevicepairing
*.vault
.env
*.p12
*.mobileprovision

# The product's source stays out of this repository: Focus Plus is closed
# source and only the README, the licence notices and the workflow are kept.
/Focus Plus/
/Focus Plus.xcodeproj/
/Focus PlusTests/
/Focus PlusUITests/
/.local-source/
